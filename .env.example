# ==========================================
# Brastel 電話OTP認証サービス 環境変数設定
# ==========================================

# --- サービス設定 ---
SERVICE_NAME=アピレンティック電話認証サービス
API_KEY=your-secret-api-key-here
SECRET_ENCRYPTION_KEY=           # Fernet キー（空の場合は起動時に自動生成してログに出力）

# --- Brastel SIP設定（Asterisk pjsip.confで使用）---
# これらはdocker-compose経由でAsteriskコンテナに渡される
BRASTEL_SIP_SERVER=sip.brastel.ne.jp       # BrastelのSIPサーバーアドレス
BRASTEL_SIP_USERNAME=050XXXXXXXX            # SIPユーザー名（050番号）
BRASTEL_SIP_PASSWORD=your-sip-password     # SIPパスワード
BRASTEL_SIP_CALLER_ID=050XXXXXXXX          # 発信者番号として表示する050番号

# --- Asterisk AMI設定 ---
ASTERISK_HOST=127.0.0.1
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USERNAME=telauth
ASTERISK_AMI_PASSWORD=your-ami-secret
ASTERISK_CONTEXT=outbound-otp              # extensions.confのコンテキスト名
ASTERISK_ENDPOINT=brastel-endpoint         # pjsip.confのエンドポイント名
ASTERISK_CALL_TIMEOUT_MS=30000            # 発信タイムアウト（ミリ秒）

# --- Asterisk → API 内部呼び出しの保護 ---
# 設定すると /api/v1/inbound, /inbound-verify, /call-complete は X-Internal-Token ヘッダが必要になる。
# Asterisk コンテナにも同じ .env が渡り、ダイヤルプランが ${ENV(INTERNAL_TOKEN)} で送る。
# 空なら検査しない。生成例: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_TOKEN=

# --- OTP設定 ---
OTP_INTERVAL_SECONDS=900         # OTP有効期間（秒）デフォルト15分
OTP_DIGITS=6
CALL_RATE_LIMIT_SECONDS=300      # 同一番号への再発信制限（秒）
VERIFY_MAX_FAILURES=5            # 有効期間内のコード照合失敗の上限（超えるとロック）

# --- データベース ---
DATABASE_URL=sqlite+aiosqlite:///./telauth.db
