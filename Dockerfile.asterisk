FROM andrius/asterisk:latest

# ベースイメージは /etc/asterisk と /var/lib/asterisk/sounds を匿名ボリュームにしているため、
# イメージ内に直接置いても再起動時に古いボリューム内容で上書きされてしまう。
# そのため /opt/telauth に置き、entrypoint.sh が起動時に正しい場所へコピーする。
COPY asterisk/pjsip.conf.template \
     asterisk/manager.conf.template \
     asterisk/extensions.conf \
     asterisk/musiconhold.conf \
     asterisk/rtp.conf \
     asterisk/logger.conf \
     asterisk/http.conf \
     /opt/telauth/etc/

# IVR用音声ファイル (メニュー / 混雑案内 / 保留音)
COPY asterisk/sounds/ /opt/telauth/sounds/

COPY asterisk/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
