; Asterisk PJSIP Configuration for Brastel

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0

[brastel-auth]
type=auth
auth_type=userpass
username=${BRASTEL_SIP_USERNAME}
password=${BRASTEL_SIP_PASSWORD}

[brastel-aor]
type=aor
contact=sip:${BRASTEL_SIP_SERVER}

[global]
type=global
default_outbound_endpoint=brastel-endpoint

[anonymous]
type=endpoint
context=from-brastel
; RFC4733(RFC2833)がSDPで合意できればそれを使い、無ければ音声内(inband)のDTMFを検出する
dtmf_mode=auto
disallow=all
allow=ulaw
allow=alaw

[brastel-endpoint]
type=endpoint
transport=transport-udp
dtmf_mode=auto
aors=brastel-aor
outbound_auth=brastel-auth
context=from-brastel
disallow=all
allow=ulaw
allow=alaw
rewrite_contact=yes
rtp_symmetric=yes
force_rport=yes
direct_media=no

[brastel-reg]
type=registration
transport=transport-udp
outbound_auth=brastel-auth
server_uri=sip:${BRASTEL_SIP_SERVER}
client_uri=sip:${BRASTEL_SIP_USERNAME}@${BRASTEL_SIP_SERVER}
retry_interval=60
expiration=3600

; ---------------------------------------------------------------------------
; 担当者のブラウザ (内線の受話) 用 WebRTC
;   ブラウザ → wss://<PUBLIC_BASE_URL>/ws → FastAPI が中継 → ws://127.0.0.1:8088/ws (http.conf)
;   担当者用アカウントは web1..webN のプール。entrypoint.sh が [webrtc-*] テンプレートを使って
;   このファイルの末尾に生成する (パスワード = sha256("<WEBRTC_SECRET>:<slot>") の先頭 32 文字)。
; ---------------------------------------------------------------------------
[transport-ws]
type=transport
protocol=ws
bind=0.0.0.0
; NAT 内なので SDP / Contact に公開 IP を書く (entrypoint.sh が PUBLIC_IP を展開)
external_media_address=${PUBLIC_IP}
external_signaling_address=${PUBLIC_IP}
local_net=192.168.0.0/16
local_net=172.16.0.0/12
local_net=10.0.0.0/8
local_net=127.0.0.0/8

[webrtc-endpoint](!)
type=endpoint
context=from-webrtc
; webrtc=yes = use_avpf, ice_support, media_encryption=dtls, dtls_auto_generate_cert, rtcp_mux などをまとめて有効化
webrtc=yes
disallow=all
allow=opus
allow=ulaw
allow=alaw
dtmf_mode=rfc4733
direct_media=no
rewrite_contact=yes
rtp_symmetric=yes
force_rport=yes

[webrtc-aor](!)
type=aor
max_contacts=1
remove_existing=yes

[webrtc-auth](!)
type=auth
auth_type=userpass
